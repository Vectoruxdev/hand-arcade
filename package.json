{
  "name": "hand-arcade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A full-screen family arcade you run entirely with your hands.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 4800 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4800 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tools/smoke.spec.ts",
    "check:games": "node scripts/check-games.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:games",
    "postinstall": "node scripts/copy-wasm.ts",
    "capture": "CAPTURE=1 playwright test tools/capture.spec.ts",
    "fps": "FPS=1 playwright test tools/fps.spec.ts",
    "loud": "LOUD=1 playwright test tools/loud.spec.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.22",
    "@types/three": "^0.187.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
